    {
      "name": "4. API 3 - Available Sessions (Aggregation Pipeline)",
      "item": [
        {
          "name": "Get Available Sessions by dateTimestamp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Returns AVAILABLE sessions with teacher info', function () {",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    pm.expect(json.data.length).to.be.at.least(2);",
                  "    json.data.forEach(s => {",
                  "        pm.expect(s.status).to.eql('AVAILABLE');",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/sessions/available?dateTimestamp={{dateTimestamp}}",
              "host": ["{{baseUrl}}"],
              "path": ["sessions", "available"],
              "query": [
                {
                  "key": "dateTimestamp",
                  "value": "{{dateTimestamp}}",
                  "description": "Unix timestamp in ms (e.g. 1795132800000 for 2026-11-20 UTC) or seconds or ISO date"
                }
              ]
            }
          }
        }
      ]
    },
