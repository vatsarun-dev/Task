    {
      "name": "7. API 6 - User Session List (Aggregation Pipeline)",
      "item": [
        {
          "name": "Get User Upcoming & Completed Sessions",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.test('Separates upcomingSessions and completedSessions', function () {",
                  "    pm.expect(json.data.upcomingSessions).to.be.an('array');",
                  "    pm.expect(json.data.completedSessions).to.be.an('array');",
                  "    pm.expect(json.data.upcomingSessions.length).to.eql(1);",
                  "    pm.expect(json.data.completedSessions.length).to.eql(1);",
                  "    pm.expect(json.data.upcomingSessions[0].status).to.eql('BOOKED');",
                  "    pm.expect(json.data.completedSessions[0].status).to.eql('COMPLETED');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/sessions",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "sessions"]
            }
          }
        }
